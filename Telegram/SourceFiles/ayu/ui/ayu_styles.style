using "ui/basic.style";
using "ui/colors.palette";
using "ui/widgets/widgets.style";
using "info/info.style";

/* Icon Picker */
cpPadding: 14px;
cpSelectedPadding: 2px;
cpSelectedRounding: 12px;
cpImagePadding: 4px;
cpSpacingX: 16px;
cpSpacingY: 8px;
cpIconSize: 64px;

recentStickersLimitPadding: margins(22px, 4px, 22px, 8px);
imageViewPadding: margins(22px, 10px, 22px, 10px);
imageViewInnerPadding: margins(16px, 16px, 16px, 16px);

botWebViewPanelHeightIncreased: 782px;
botWebViewPanelWidthIncreased: 512px;

stickerRoundingSize: 5px;

messageShotPadding: 4px;

topBarAdmins: IconButton {
	width: 40px;
	height: topBarHeight;

	icon: icon {{ "ayu/top_bar_admins", menuIconFg }};
	iconOver: icon {{ "ayu/top_bar_admins", menuIconFgOver }};
	iconPosition: point(4px, 11px);

	rippleAreaPosition: point(0px, 7px);
	rippleAreaSize: 40px;
	ripple: RippleAnimation(defaultRippleAnimation) {
		color: windowBgOver;
	}
}

topBarRecentActions: IconButton {
	width: 40px;
	height: topBarHeight;

	icon: icon {{ "ayu/top_bar_recent_actions", menuIconFg }};
	iconOver: icon {{ "ayu/top_bar_recent_actions", menuIconFgOver }};
	iconPosition: point(4px, 11px);

	rippleAreaPosition: point(0px, 7px);
	rippleAreaSize: 40px;
	ripple: RippleAnimation(defaultRippleAnimation) {
		color: windowBgOver;
	}
}

exteraBadgeToast: Toast(defaultToast) {
	minWidth: 40px;
	maxWidth: 480px;
	padding: margins(54px, 13px, 19px, 12px);
	icon: icon {{ "ayu/extera_badge", toastFg }};
	iconPosition: point(13px, 13px);
}

supportLogoSize: 96px;

unreadPillPadding: 12px;

infoProfileLabeledButtonRegistrationDate: IconButton(defaultIconButton) {
	width: 34px;
	height: 34px;
	icon: icon {{ "menu/calendar", windowActiveTextFg }};
	iconOver: icon {{ "menu/calendar", windowActiveTextFg }};
	rippleAreaPosition: point(0px, 0px);
	rippleAreaSize: 34px;
	ripple: defaultRippleAnimation;
}
registrationDateImportantTooltipLabel: FlatLabel(defaultImportantTooltipLabel) {
	style: TextStyle(defaultTextStyle) {
		font: font(12px);
	}
}

/* ============================================
 * AyuGram iOS/Web Visual Enhancements
 * ============================================ */

/* Chat bubble customization */
ayuBubbleRadiusDefault: 21px;
ayuBubbleRadiusSmall: 12px;
ayuBubbleRadiusLarge: 24px;

/* Message spacing - iOS style */
ayuMessageSpacingCompact: margins(10px, 6px, 10px, 6px);
ayuMessageSpacingNormal: margins(12px, 10px, 12px, 10px);
ayuMessageSpacingComfortable: margins(14px, 12px, 14px, 12px);

/* Chat list row heights */
ayuDialogRowCompact: 62px;
ayuDialogRowNormal: 72px;
ayuDialogRowComfortable: 80px;

/* Avatar sizes for chat list */
ayuAvatarSmall: 42px;
ayuAvatarNormal: 52px;
ayuAvatarLarge: 58px;

/* Online indicator */
ayuOnlineBadgeSmall: 10px;
ayuOnlineBadgeNormal: 14px;
ayuOnlineBadgeLarge: 16px;

/* Animation durations - smoother transitions */
ayuTransitionFast: 120;
ayuTransitionNormal: 200;
ayuTransitionSlow: 350;

/* Shadows */
ayuShadowLight: 2px;
ayuShadowNormal: 3px;
ayuShadowStrong: 5px;

/* Input field styling */
ayuInputBorderRadius: 22px;
ayuInputPadding: margins(16px, 12px, 16px, 12px);

/* Floating action button */
ayuFabSize: 56px;
ayuFabIconSize: 24px;
ayuFabShadow: 8px;
